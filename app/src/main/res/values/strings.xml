    <string name="settings_engine_desc">Choose which service translates the recognized speech.</string>
    <string name="engine_deepseek">DeepSeek</string>
    <string name="engine_deepseek_summary">Streaming, high quality · needs an API key</string>
    <string name="engine_microsoft">Microsoft (free)</string>
    <string name="engine_microsoft_summary">No key needed · subtitle appears per sentence</string>
    <string name="engine_zhipu">Zhipu GLM (智谱)</string>
    <string name="engine_zhipu_summary">Streaming · glm-4-flash is on the free tier · needs an API key</string>
    <string name="engine_google_free">Google Translate (free)</string>
    <string name="engine_google_free_summary">No key needed · unofficial endpoint, may be rate-limited</string>
    <string name="engine_gemini">Google Gemini</string>
    <string name="engine_gemini_summary">Streaming · has a free tier · needs a Google AI Studio key</string>
    <string name="settings_deepseek_key">DeepSeek API Key</string>
    <string name="settings_deepseek_base_url">API base URL (advanced)</string>
    <string name="settings_zhipu_key">Zhipu GLM API Key</string>
    <string name="settings_zhipu_base_url">API base URL (advanced)</string>
    <string name="settings_zhipu_model_hint">Tip: some newer models (the glm-5.3 family) force thinking on and answer error 1210 when asked to turn it off. If that happens the app retries automatically; pick glm-4-flash to avoid it entirely.</string>
    <string name="settings_gemini_key">Gemini API Key (Google AI Studio)</string>
    <string name="settings_microsoft_desc">Uses the free Microsoft Translator endpoint, no key required. It may occasionally be rate-limited; switch to DeepSeek if it stops responding.</string>
    <string name="settings_google_free_desc">Google\'s keyless web endpoint. It is undocumented, so it can change or rate-limit without notice — if it stops working, switch to the API Key channel or Microsoft.</string>
    <string name="settings_gemini_base_url">API base URL (advanced)</string>
    <string name="settings_gemini_model_hint">Get a free key at Google AI Studio (aistudio.google.com). Google retired gemini-2.5-flash for new API users, so the presets now use the 3.x Flash line.</string>
    <string name="engine_generic">Custom API (OpenAI-compatible)</string>
    <string name="engine_generic_summary">Any OpenAI-compatible service · key optional</string>
    <string name="settings_generic_key">API Key (optional)</string>
    <string name="settings_generic_base_url">Service base URL</string>
    <string name="settings_generic_hint">Include the path prefix, e.g. https://your-relay.example.com/v1 — do not add /chat/completions (it is appended for you). Leave the key empty only for local servers that need none, such as Ollama or LM Studio.</string>
    <string name="settings_generic_thinking_style">\"Disable thinking\" parameter</string>
    <string name="settings_generic_thinking_none">Don\'t send</string>
    <string name="settings_generic_thinking_object">thinking object</string>
    <string name="settings_generic_thinking_effort">reasoning_effort</string>
    <string name="settings_generic_thinking_hint">Pick whichever shape your provider understands. It is sent only while the AI deep-thinking switch below is off; with \"Don\'t send\" that switch has no effect on this engine.</string>

