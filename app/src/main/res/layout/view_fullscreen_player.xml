<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView, not the default SurfaceView: a SurfaceView is composited in its own
  layer, so Compose's graphicsLayer scale/translate never reaches it. The pinch-to-zoom
  in the fullscreen dialog only works because this surface lives in the normal view
  hierarchy.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never" />
